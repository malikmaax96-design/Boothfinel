# ──────────────────────────────────────────────────────────────────────────
# Boothdrop Entertainment — Apache configuration (generated by scripts/build-pages.js
# from templates/htaccess.txt + data/redirects.json; edit those, not this file).
# ──────────────────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS + www (single hop: any non-canonical host/scheme → https://www.)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.boothdrop\.co\.uk$ [NC]
  RewriteCond %{HTTP_HOST} ^(www\.)?boothdrop\.co\.uk$ [NC]
  RewriteRule ^(.*)$ https://www.boothdrop.co.uk/$1 [R=301,L]

  # 2. Legacy URL redirects (generated from data/redirects.json; .html and trailing-slash variants included)
  RewriteRule ^booths/lcd-slimpod(\.html)?/?$ /booths/lcd-slimpod-hire [R=301,L,NE]
  RewriteRule ^booths/magic-mirror(\.html)?/?$ /booths/magic-mirror-hire [R=301,L,NE]
  RewriteRule ^booths/selfie-mirror-pod(\.html)?/?$ /booths/selfie-mirror-pod-hire [R=301,L,NE]
  RewriteRule ^booths/retro-pod(\.html)?/?$ /booths/retro-pod-hire [R=301,L,NE]
  RewriteRule ^booths/party-booth(\.html)?/?$ /booths/party-booth-hire [R=301,L,NE]
  RewriteRule ^booths/inflatable-booth(\.html)?/?$ /booths/inflatable-photo-booth-hire [R=301,L,NE]
  RewriteRule ^booths/gif-booth(\.html)?/?$ /booths/gif-booth-hire [R=301,L,NE]
  RewriteRule ^services(\.html)?/?$ /events/ [R=301,L,NE]
  RewriteRule ^gallery(\.html)?/?$ /#gallery [R=301,L,NE]
  RewriteRule ^about(\.html)?/?$ /#about [R=301,L,NE]
  RewriteRule ^book(\.html)?/?$ /contact#book [R=301,L,NE]
  RewriteRule ^booking(\.html)?/?$ /contact#book [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-london(\.html)?/?$ /areas/photo-booth-hire-london [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-central-london(\.html)?/?$ /areas/photo-booth-hire-central-london [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-north-london(\.html)?/?$ /areas/photo-booth-hire-north-london [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-east-london(\.html)?/?$ /areas/photo-booth-hire-east-london [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-south-london(\.html)?/?$ /areas/photo-booth-hire-south-london [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-south-east-london(\.html)?/?$ /areas/photo-booth-hire-south-east-london [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-south-west-london(\.html)?/?$ /areas/photo-booth-hire-south-west-london [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-west-london(\.html)?/?$ /areas/photo-booth-hire-west-london [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-oxfordshire(\.html)?/?$ /areas/photo-booth-hire-oxfordshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-berkshire(\.html)?/?$ /areas/photo-booth-hire-berkshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-hampshire(\.html)?/?$ /areas/photo-booth-hire-hampshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-kent(\.html)?/?$ /areas/photo-booth-hire-kent [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-essex(\.html)?/?$ /areas/photo-booth-hire-essex [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-surrey(\.html)?/?$ /areas/photo-booth-hire-surrey [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-cambridgeshire(\.html)?/?$ /areas/photo-booth-hire-cambridgeshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-west-sussex(\.html)?/?$ /areas/photo-booth-hire-west-sussex [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-bedfordshire(\.html)?/?$ /areas/photo-booth-hire-bedfordshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-hertfordshire(\.html)?/?$ /areas/photo-booth-hire-hertfordshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-buckinghamshire(\.html)?/?$ /areas/photo-booth-hire-buckinghamshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-nottinghamshire(\.html)?/?$ /areas/photo-booth-hire-nottinghamshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-northamptonshire(\.html)?/?$ /areas/photo-booth-hire-northamptonshire [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-oxford(\.html)?/?$ /areas/photo-booth-hire-oxford [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-bromley(\.html)?/?$ /areas/photo-booth-hire-bromley [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-northampton(\.html)?/?$ /areas/photo-booth-hire-northampton [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-aylesbury(\.html)?/?$ /areas/photo-booth-hire-aylesbury [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-reading(\.html)?/?$ /areas/photo-booth-hire-reading [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-slough(\.html)?/?$ /areas/photo-booth-hire-slough [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-chelmsford(\.html)?/?$ /areas/photo-booth-hire-chelmsford [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-cambridge(\.html)?/?$ /areas/photo-booth-hire-cambridge [R=301,L,NE]
  RewriteRule ^photobooth-for-hire-in-luton(\.html)?/?$ /areas/photo-booth-hire-luton [R=301,L,NE]

  # 3. Strip index.html from the URL (/booths/index.html → /booths/)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # 4. Strip .html from directly requested URLs (/faq.html → /faq)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 5. Remove a trailing slash from file-style URLs (/faq/ → /faq) but keep it on directories
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 6. Serve clean URLs from the matching .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ── Caching ───────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|jpe?g|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# ── Protect source/data files that are not meant to be served ────────────
<FilesMatch "\.(json|md|txt\.bak)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
RedirectMatch 404 ^/(scripts|templates|data)(/|$)
